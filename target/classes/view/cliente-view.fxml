<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="460.0"
            prefWidth="518.0"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="br.senac.sp.pizzaria.controller.ClienteController">

    <Label layoutX="30.0"
           layoutY="25.0"
           style="-fx-font-size: 22px; -fx-font-weight: bold;"
           text="Cadastro de Cliente" />

    <Label layoutX="30.0" layoutY="83.0" text="ID" />
    <TextField fx:id="tfId"
               layoutX="100.0"
               layoutY="79.0"
               prefWidth="380.0"
               promptText="Ex.: 69420" />

    <Label layoutX="30.0" layoutY="118.0" text="Telefone" />
    <TextField fx:id="tfTelefone"
               layoutX="100.0"
               layoutY="114.0"
               prefWidth="380.0"
               promptText="Ex.: (00) 00000-0000" />

    <Label layoutX="30.0" layoutY="157.0" text="Nome" />
    <TextField fx:id="tfNome"
               layoutX="100.0"
               layoutY="153.0"
               prefWidth="380.0"
               promptText="Ex. Fulano de Tal" />

    <Label layoutX="30.0" layoutY="198.0" text="Aniversário" />
    <DatePicker fx:id="dpNiver"
                layoutX="100.0"
                layoutY="194.0"
                prefWidth="380.0"
                promptText="Ex.: 01/01/2001" />

    <Label layoutX="30.0" layoutY="240.0" text="Endereço" />
    <TextArea fx:id="taEndereco"
              layoutX="100.0"
              layoutY="236.0"
              prefHeight="55.0"
              prefWidth="380.0"
              promptText="Ex.: Rua dos Beltranos, 69, casa 420" />

    <Button fx:id="btnSalvar"
            layoutX="39.0"
            layoutY="311.0"
            onAction="#salvar">
        <graphic>
            <ImageView fitHeight="39.0"
                       fitWidth="83.0"
                       pickOnBounds="true"
                       preserveRatio="true">
                <image>
                    <Image url="@../icones/salvar.png" />
                </image>
            </ImageView>
        </graphic>
    </Button>

    <Button fx:id="btnExcluir"
            layoutX="149.0"
            layoutY="311.0"
            onAction="#excluir">
        <graphic>
            <ImageView fitHeight="57.0"
                       fitWidth="40.0"
                       pickOnBounds="true"
                       preserveRatio="true">
                <image>
                    <Image url="@../icones/excluir.png" />
                </image>
            </ImageView>
        </graphic>
    </Button>

    <Button fx:id="btnLimpar"
            layoutX="253.0"
            layoutY="311.0"
            onAction="#limpar">
        <graphic>
            <ImageView fitHeight="41.0"
                       fitWidth="42.0"
                       pickOnBounds="true"
                       preserveRatio="true">
                <image>
                    <Image url="@../icones/limpar.png" />
                </image>
            </ImageView>
        </graphic>
    </Button>

    <Button fx:id="btnBuscar"
            layoutX="374.0"
            layoutY="311.0"
            onAction="#buscar">
        <graphic>
            <ImageView fitHeight="38.0"
                       fitWidth="38.0"
                       pickOnBounds="true"
                       preserveRatio="true">
                <image>
                    <Image url="@../icones/buscar.png" />
                </image>
            </ImageView>
        </graphic>
    </Button>

</AnchorPane>
